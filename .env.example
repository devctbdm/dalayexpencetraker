# Supabase Dashboard → Connect → Connection string → URI
# Use the Transaction pooler URI for serverless deployments when available.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Generate a long random value, for example: openssl rand -base64 32
# Keep this server-only; do not prefix it with NEXT_PUBLIC_.
AUTH_SECRET="replace-with-a-random-32-character-or-longer-secret"

# The public origin used in password-reset links (no trailing slash).
APP_URL="http://localhost:3000"

# Resend configuration. Use a verified sender/domain for production.
# Never commit a real Resend API key.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="DailyTrack <noreply@your-domain.com>"
